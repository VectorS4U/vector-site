---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const topics = [
  'Demo de app de campo, Home Equipo y Decisión gerencial',
  'Cotizador con catálogo y pedido de prueba',
  'Integración Softland u Odoo según su operación',
];
---

<BaseLayout
  title="Contacto"
  description={`Solicite una demo de Vector. Escríbanos a ${site.contactEmail}.`}
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Contacto
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-muted">
        Cuéntenos cómo vende su equipo hoy. Le mostramos la app de campo,
        Decisión gerencial, cotizador e integración ERP.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <h2 class="text-lg font-semibold text-ink">Escríbanos</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Correo comercial de Vector y {site.company}. Respondemos para agendar
          una demo o un piloto.
        </p>

        <div class="mt-8 space-y-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-ink">
              Correo
            </p>
            <a
              href={`mailto:${site.contactEmail}?subject=Demo%20Vector`}
              class="mt-1 inline-block text-xl font-semibold text-brand hover:text-brand-dark"
            >
              {site.contactEmail}
            </a>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-ink">
              Empresa
            </p>
            <a
              href={site.companyUrl}
              class="mt-1 inline-block text-base font-semibold text-ink underline decoration-border underline-offset-4 hover:text-brand"
              target="_blank"
              rel="noopener noreferrer"
            >
              group4u.net
            </a>
            <p class="mt-2 text-sm text-muted">
              Sitio oficial de {site.company}, la empresa detrás de Vector.
            </p>
          </div>
        </div>

        <a
          href={`mailto:${site.contactEmail}?subject=Demo%20Vector&body=Hola%2C%20quiero%20una%20demo%20de%20Vector.`}
          class="mt-10 inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-dark"
        >
          Abrir correo
        </a>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-ink">Qué podemos cubrir</h2>
        <ul class="mt-5 space-y-3">
          {
            topics.map((topic) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand" />
                {topic}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-muted">
          Incluya en el mensaje el tamaño del equipo de campo, el ERP actual (si
          aplica) y si busca demo o piloto. Así preparamos la sesión con el
          flujo adecuado.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
