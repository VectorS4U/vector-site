---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductShot from '../components/ProductShot.astro';
import { shots } from '../config/marketing';
import { withBase } from '../config/paths';
import { site } from '../config/site';

const reports = [
  'Embudo',
  'Motivos de pérdida',
  'Cotizaciones por antigüedad',
  'Visitas contra cobertura',
  'Meta vs venta',
  'Venta por familia',
  'Gasto vs venta',
  'Formularios de visita',
  'Cartera y mora',
];

const extras = [
  {
    title: 'Fuerza de venta',
    body: 'Visitas, cotizaciones, pedidos, conversión y kilómetros por vendedor. El ranking lo consulta gerencia.',
  },
  {
    title: 'Cuota y planes',
    body: 'Los planes se anclan a pedidos reales. La pantalla de gerencia muestra el ritmo de lo que el equipo ya ejecutó.',
  },
  {
    title: 'IA opcional',
    body: 'Add-on para la visita, el expediente, la cotización y un briefing del negocio. La ruta, la cotización y el pedido ya viven en el producto base.',
  },
  {
    title: 'Datos para BI',
    body: 'Exportación de información para análisis y BI (Power BI, Looker u otras herramientas). Su equipo elige el destino.',
  },
];

const syncModes = [
  {
    title: 'Con conexión',
    body: 'El vendedor puede refrescar catálogo, precios y resumen del cliente según el conector ERP activo. La supervisión y gerencia ven el estado actualizado en web.',
  },
  {
    title: 'Sin conexión',
    body: 'Trabaja con la información de la última sincronización: cuentas de la ruta, catálogo y resumen descargados. La fecha de esa sincronización es visible en la app.',
  },
  {
    title: 'Antes de confirmar',
    body: 'Cuando hay red, Vector vuelve a validar precios, existencias y condiciones relevantes antes de operaciones sensibles (por ejemplo, enviar o convertir en pedido).',
  },
];

const integrations = [
  {
    name: 'Softland',
    status: 'Piloto',
    body: 'Agente en el servidor de su empresa. Catálogo, cliente y resumen comercial hacia Vector; el ERP sigue dueño de lo transaccional.',
  },
  {
    name: 'Odoo',
    status: 'Piloto',
    body: 'Conector en la nube. Mismo principio: Vector concentra el ciclo comercial; Odoo mantiene maestros y facturación.',
  },
  {
    name: 'Sin conector',
    status: 'Disponible',
    body: 'Visitas, pipeline y cotizador funcionan con catálogo de demostración o cargado en Vector mientras se define la integración.',
  },
];
---

<BaseLayout
  title="Producto"
  description="Rutas, visitas, cotizaciones y seguimiento comercial. El vendedor asesora con precio, existencia e historial; gerencia ve la cuota y qué retomar."
>
  <section class="relative overflow-hidden border-b border-border">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(16,185,129,0.14),transparent),linear-gradient(180deg,#f8fafc_0%,#ffffff_55%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 sm:gap-10 sm:px-6 sm:py-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-10 lg:px-8 lg:py-20"
    >
      <div class="min-w-0">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">
          Producto
        </p>
        <h1
          class="mt-3 max-w-xl text-4xl font-bold tracking-tight text-ink sm:text-5xl"
        >
          La venta se cierra en campo. El vendedor llega listo para asesorar.
        </h1>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-muted sm:text-lg">
          Lleva a la visita el precio, la existencia, el crédito y el historial
          de la cuenta. Oportunidades, observaciones y seguimientos quedan en
          Vector. Usted ve la cuota, el embudo y lo que hay que retomar.
        </p>
        <a
          href={withBase('/contacto')}
          class="mt-7 inline-flex items-center justify-center rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-dark"
        >
          Solicitar una demostración
        </a>
      </div>
      <div
        class="mx-auto w-full max-w-[22rem] sm:max-w-[26rem] lg:mx-0 lg:max-w-none lg:justify-self-end"
      >
        <ProductShot {...shots.route} priority variant="hero" />
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div
        class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-12"
      >
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">
            App de campo
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
            Frente al cliente, con lo necesario para responder
          </h2>
          <p class="mt-3 leading-relaxed text-muted">
            En iOS y Android el vendedor abre la ruta, registra la visita y
            arma la cotización con el catálogo sincronizado. En la cuenta tiene
            la última oferta, el crédito, lo que se observó y el seguimiento
            pendiente. Si se corta la señal, sigue con esa información. Al
            volver la red, Vector actualiza el trabajo pendiente. Enviar la
            cotización pide conexión.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-muted">
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              La oferta se trabaja en la visita, con existencia y precio
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              Observaciones y el siguiente paso quedan en la cuenta
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              Crédito y última cotización, para asesorar con criterio
            </li>
          </ul>
        </div>
        <div class="flex items-end justify-center gap-4 sm:gap-5 lg:justify-end">
          <div class="w-[42%] max-w-[11.5rem] shrink-0 sm:max-w-[13rem]">
            <ProductShot {...shots.mobileRoute} variant="phone" />
          </div>
          <div class="w-[48%] max-w-[13rem] shrink-0 sm:max-w-[14.5rem]">
            <ProductShot {...shots.mobileVisita} variant="phone" mirror />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <ProductShot
          {...shots.decision}
          variant="stage"
          mirror
          class="order-2 lg:order-1"
        />
        <div class="order-1 lg:order-2">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">
            Gerencia
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
            Cuatro preguntas, una pantalla
          </h2>
          <p class="mt-3 leading-relaxed text-muted">
            Cada visita deja la oportunidad, la observación y el seguimiento en
            Vector. El supervisor ve cumplimiento y quién está en ruta. Usted
            abre el ritmo de la cuota, el embudo por monto, las oportunidades
            sin seguimiento y el equipo. Cada cifra lleva a su lista.
          </p>
          <ul class="mt-5 space-y-2.5 text-sm text-muted">
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              ¿Vamos a la cuota de este mes?
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              ¿En qué etapa está el monto del embudo?
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              ¿Qué oportunidad quedó sin seguimiento?
            </li>
            <li class="flex gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"
              ></span>
              ¿A quién hay que retomar?
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">
            Expediente
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
            Oportunidades, observaciones y seguimientos, en la misma cuenta
          </h2>
          <p class="mt-3 leading-relaxed text-muted">
            La ficha abre el hilo de la relación: qué se visitó, qué se cotizó,
            qué se anotó y qué sigue. Arriba, el resumen marca la última visita,
            la última oferta y el pendiente. El vendedor entra a la siguiente
            cita con esa lectura. Al convertir, Vector conserva el mismo
            registro y vincula el cliente del ERP.
          </p>
        </div>
        <ProductShot {...shots.expediente} variant="stage" />
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <ProductShot
          {...shots.tracking}
          variant="stage"
          mirror
          class="order-2 lg:order-1"
        />
        <div class="order-1 lg:order-2">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">
            Agenda y seguimiento
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
            El plan se aprueba. El seguimiento queda en la visita.
          </h2>
          <p class="mt-3 leading-relaxed text-muted">
            El vendedor propone las visitas del periodo. El supervisor las
            aprueba. En cada parada quedan el check-in, la evidencia y la
            observación. En la oficina, el mapa muestra al equipo en ruta, las
            zonas de cobertura, las paradas y la traza del día.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">
            Cotizador
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
            Asesora con existencia. La oferta queda en Vector.
          </h2>
          <p class="mt-3 leading-relaxed text-muted">
            En la visita arma el borrador con el catálogo sincronizado:
            producto, precio y existencia para responder ahí mismo. En la web
            se cierran las versiones, el PDF y el envío desde el correo del
            vendedor. Si el descuento pide aprobación, el flujo sigue en la
            misma hoja. Si la oportunidad se pierde, queda el motivo. Si el
            cliente acepta, el pedido nace de esa cotización.
          </p>
        </div>
        <ProductShot {...shots.quote} variant="stage" />
      </div>
    </div>
  </section>

  <section id="sincronizacion" class="scroll-mt-20 border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">
          Información del ERP
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Conexión, sin señal y validación al confirmar
        </h2>
        <p class="mt-3 text-muted">
          Diferenciamos qué consulta se hace en vivo, qué se trabaja con la
          última sincronización y qué se vuelve a validar antes de confirmar.
        </p>
      </div>
      <ul class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          syncModes.map((item) => (
            <li class="rounded-xl border border-border bg-white p-5">
              <h3 class="text-base font-semibold text-ink">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">
          Integraciones
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Qué está operativo y qué está en piloto
        </h2>
        <p class="mt-3 text-muted">
          Vendemos con claridad: el ciclo comercial corre en Vector; los
          conectores ERP se habilitan según la operación.
        </p>
      </div>
      <ul class="mt-8 grid gap-6 sm:grid-cols-3">
        {
          integrations.map((item) => (
            <li class="border-l-2 border-brand pl-4">
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="text-base font-semibold text-ink">{item.name}</h3>
                <span class="text-xs font-semibold uppercase tracking-wider text-brand">
                  {item.status}
                </span>
              </div>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand">
          Pedidos e informes
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          El pedido sale de la cotización aceptada
        </h2>
        <p class="mt-3 text-muted">
          Gerencia lee lo que el campo ya ejecutó: embudo, cobertura, cuota,
          mora y el resto de la operación, en nueve informes listos.
        </p>
      </div>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          reports.map((name) => (
            <li class="rounded-lg border border-border bg-white px-4 py-3.5 text-sm font-semibold text-ink">
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
        <ProductShot
          {...shots.perfil}
          variant="stage"
          mirror
          class="order-2 lg:order-1"
        />
        <div class="order-1 lg:order-2">
          <p class="text-sm font-semibold uppercase tracking-widest text-brand">
            ERP y negociación
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-ink sm:text-3xl">
            Asesora con el dato del ERP. La negociación sigue en Vector.
          </h2>
          <p class="mt-3 leading-relaxed text-muted">
            Softland y Odoo siguen dueños de lo transaccional. En la ficha el
            vendedor ve catálogo, precio, crédito y mora cuando el conector lo
            permite, y responde con ese dato. Oportunidades, observaciones y
            seguimientos viven en Vector. Mientras el conector entra en piloto,
            el ciclo se recorre con datos de demostración.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="it" class="scroll-mt-20 border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <details class="group rounded-xl border border-border bg-white open:shadow-sm">
        <summary
          class="cursor-pointer list-none px-5 py-4 text-base font-semibold text-ink marker:content-none [&::-webkit-details-marker]:hidden sm:px-6 sm:py-5 sm:text-lg"
        >
          <span class="flex items-center justify-between gap-4">
            Información para su equipo de IT
            <span
              class="shrink-0 text-sm font-medium text-brand transition group-open:rotate-45"
              aria-hidden="true">+</span
            >
          </span>
        </summary>
        <div class="border-t border-border px-5 py-5 text-sm leading-relaxed text-muted sm:px-6 sm:py-6">
          <ul class="space-y-4">
            <li>
              <span class="font-semibold text-ink">Softland.</span>
              Agente instalado en el servidor de su empresa, con salida segura a
              internet hacia Vector. No requiere exponer el ERP a internet
              entrante. Alcance del piloto: catálogo, cliente y resumen
              comercial según el alcance acordado.
            </li>
            <li>
              <span class="font-semibold text-ink">Odoo.</span>
              Conector en la nube hacia su instancia. Misma separación: Vector
              es dueño del ciclo comercial; Odoo de maestros y transaccional.
            </li>
            <li>
              <span class="font-semibold text-ink">Sincronización móvil.</span>
              La app descarga la información del día (cuentas de ruta, catálogo,
              resumen) para trabajar sin señal. Los registros creados offline
              quedan pendientes de envío hasta recuperar conexión.
            </li>
            <li>
              <span class="font-semibold text-ink">BI (add-on).</span>
              Exportación de información para análisis hacia el destino que
              defina su equipo (por ejemplo almacenes analíticos o herramientas
              de BI).
            </li>
            <li>
              <span class="font-semibold text-ink">Hosting.</span>
              Vector se opera como servicio. Detalle de red, certificados y
              ventanas de mantenimiento se acuerdan en el piloto.
            </li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Cuando la operación ya corre
        </h2>
        <p class="mt-3 text-muted">
          Capas que se suman cuando la venta en campo ya está en marcha. La
          visita, la cotización y el seguimiento arrancan sin ellas.
        </p>
      </div>
      <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {
          extras.map((item) => (
            <li class="border-l-2 border-brand pl-4">
              <h3 class="text-base font-semibold text-ink">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-surface">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-12 sm:flex-row sm:items-center sm:px-6 sm:py-14 lg:px-8"
    >
      <div class="max-w-xl">
        <h2 class="text-2xl font-bold tracking-tight text-ink">
          Prospecto en Vector. Cliente en el ERP. El mismo expediente.
        </h2>
        <p class="mt-2 text-muted">
          Al ganar se vincula el cliente del ERP. Visitas, cotizaciones y
          seguimientos permanecen en el mismo expediente. Una plataforma de{' '}
          {site.company} — {site.companyLegal}.
        </p>
      </div>
      <a
        href={withBase('/contacto')}
        class="inline-flex shrink-0 items-center justify-center rounded-lg bg-ink px-6 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
      >
        Solicitar una demostración
      </a>
    </div>
  </section>
</BaseLayout>
