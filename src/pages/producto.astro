---
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = [
  {
    name: 'Inicio y pipeline',
    detail: 'KPIs del día, oportunidades y montos sincronizados desde cotizaciones enviadas.',
  },
  {
    name: 'Cuentas y expediente',
    detail: 'Contactos, visitas, competidores, cotizaciones y pedidos en un solo lugar.',
  },
  {
    name: 'Agenda y visitas',
    detail: 'Check-in GPS, evidencias y plan de ruta. Prospecto pasa a contactado al cerrar visita.',
  },
  {
    name: 'Cotizador',
    detail: 'Líneas con catálogo, existencia y condiciones de pago. PDF y versiones.',
  },
  {
    name: 'Pedidos',
    detail: 'Desde cotización aceptada. Webhooks y ERP según tu flujo documental.',
  },
  {
    name: 'Integración ERP',
    detail: 'Agente on-prem: catálogos, alta de cliente y resumen de crédito sin VPN inversa.',
  },
];
---

<BaseLayout
  title="Producto"
  description="Módulos de Vector: campo, CRM comercial, cotizaciones e integración ERP."
>
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Producto
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Vector es el sistema donde vive el vendedor: de la visita a la cotización,
        del pipeline al pedido — con tu ERP conectado cuando lo necesitas.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <ul class="divide-y divide-border border-y border-border">
      {
        modules.map((mod) => (
          <li class="flex flex-col gap-1 py-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
            <h2 class="text-base font-semibold text-ink">{mod.name}</h2>
            <p class="max-w-xl text-sm text-muted">{mod.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
