---
import { legal } from '../config/legal';
import { withBase } from '../config/paths';
import { nav, site } from '../config/site';

const year = new Date().getFullYear();
const loginUrl = `${site.appUrl.replace(/\/$/, '')}/login`;
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <img
          src={withBase('/brand/logo-full.svg')}
          alt={site.name}
          width="200"
          height="48"
          class="h-10 w-auto"
        />
        <p class="mt-4 text-sm leading-relaxed text-muted">
          {site.description}
        </p>
        <p class="mt-4 text-sm text-muted">
          Un producto de{' '}
          <a
            href={site.companyUrl}
            class="font-medium text-ink underline decoration-border underline-offset-4 hover:text-brand"
            target="_blank"
            rel="noopener noreferrer"
          >
            {site.company}
          </a>
        </p>
      </div>

      <div class="flex flex-wrap gap-12 sm:gap-16">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink">
            Sitio
          </p>
          <ul class="mt-3 space-y-2">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={withBase(item.href)}
                    class="text-sm text-muted transition-colors hover:text-ink"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink">
            Contacto
          </p>
          <ul class="mt-3 space-y-2">
            <li>
              <a
                href={`mailto:${site.contactEmail}`}
                class="text-sm text-muted transition-colors hover:text-ink"
              >
                {site.contactEmail}
              </a>
            </li>
            <li>
              <a
                href={site.companyUrl}
                class="text-sm text-muted transition-colors hover:text-ink"
                target="_blank"
                rel="noopener noreferrer"
              >
                group4u.net
              </a>
            </li>
            <li>
              <a
                href={loginUrl}
                class="text-sm text-muted transition-colors hover:text-ink"
              >
                Iniciar sesión
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink">
            Legal
          </p>
          <ul class="mt-3 space-y-2">
            <li>
              <a
                href={withBase(legal.termsPath)}
                class="text-sm text-muted transition-colors hover:text-ink"
              >
                Términos de uso
              </a>
            </li>
            <li>
              <a
                href={withBase(legal.privacyPath)}
                class="text-sm text-muted transition-colors hover:text-ink"
              >
                Privacidad
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-border pt-6 text-xs text-muted">
      © {year} {site.name} · {site.company} ({legal.operator}). Sales Execution
      Platform.
    </p>
  </div>
</footer>
