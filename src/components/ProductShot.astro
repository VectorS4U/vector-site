---
import { withBase } from '../config/paths';

type Props = {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Prioridad LCP (hero). */
  priority?: boolean;
  /**
   * hero — destacado, tamaño contenido
   * stage — sección (default)
   * tile — grid de roles, más chico
   * flat — sin perspectiva
   */
  variant?: 'hero' | 'stage' | 'tile' | 'flat';
  /** Invierte el ángulo (columnas izquierdas). */
  mirror?: boolean;
  class?: string;
};

const {
  src,
  alt,
  width,
  height,
  priority = false,
  variant = 'stage',
  mirror = false,
  class: className = '',
} = Astro.props;
---

<figure
  class:list={[
    'frame',
    `frame--${variant}`,
    mirror && 'frame--mirror',
    className,
  ]}
>
  <div class="frame__stage">
    <div class="frame__glow" aria-hidden="true"></div>
    <div class="frame__shadow" aria-hidden="true"></div>
    <div class="frame__device">
      <div class="frame__chrome" aria-hidden="true">
        <span class="frame__dot frame__dot--r"></span>
        <span class="frame__dot frame__dot--y"></span>
        <span class="frame__dot frame__dot--g"></span>
        <span class="frame__bar"></span>
      </div>
      <div class="frame__viewport">
        <img
          src={withBase(src)}
          alt={alt}
          width={width}
          height={height}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : 'auto'}
          class="frame__img"
        />
      </div>
    </div>
  </div>
</figure>

<style>
  /*
    Perspectiva “monitor en el escritorio”:
    - perspective alto → menos distorsión / skew
    - poco rotateY + un toque de rotateX → profundidad real
    - sombra elíptica en el piso → ancla el objeto en el espacio
  */
  .frame {
    --ry: -11deg;
    --rx: 6deg;
    --rz: 0deg;
    --max: 36rem;
    --persp: 2200px;
    margin: 0;
  }

  .frame--hero {
    --ry: -20deg;
    --rx: 10deg;
    --max: 100%;
    --persp: 1400px;
  }

  .frame--stage {
    --ry: -10deg;
    --rx: 5.5deg;
    --max: 32rem;
  }

  .frame--tile {
    --ry: -8deg;
    --rx: 4.5deg;
    --max: 100%;
  }

  .frame--flat {
    --ry: 0deg;
    --rx: 0deg;
    --max: 100%;
  }

  .frame--mirror {
    --ry: 11deg;
  }

  .frame--mirror.frame--hero {
    --ry: 20deg;
  }

  .frame--mirror.frame--stage {
    --ry: 10deg;
  }

  .frame--mirror.frame--tile {
    --ry: 8deg;
  }

  .frame__stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding: 1.5rem 1.25rem 2.75rem;
    perspective: var(--persp);
    perspective-origin: 50% 45%;
  }

  .frame--hero .frame__stage {
    padding: 1.25rem 1.5rem 2.5rem;
  }

  .frame--tile .frame__stage {
    padding: 0.85rem 0.5rem 1.85rem;
  }

  .frame--flat .frame__stage {
    padding: 0;
    perspective: none;
  }

  .frame__glow {
    pointer-events: none;
    position: absolute;
    left: 12%;
    right: 12%;
    top: 10%;
    bottom: 22%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 50% 45%,
      rgb(16 185 129 / 14%),
      transparent 70%
    );
  }

  .frame--flat .frame__glow,
  .frame--flat .frame__shadow {
    display: none;
  }

  /* Sombra en el “piso”: vende el 3D mejor que el skew agresivo */
  .frame__shadow {
    pointer-events: none;
    position: absolute;
    z-index: 0;
    left: 14%;
    right: 14%;
    bottom: 0.85rem;
    height: 1.75rem;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgb(15 23 42 / 28%) 0%,
      rgb(15 23 42 / 10%) 45%,
      transparent 72%
    );
    filter: blur(2px);
    transform: scaleX(1.05);
  }

  .frame--tile .frame__shadow {
    bottom: 0.55rem;
    height: 1.25rem;
    left: 16%;
    right: 16%;
  }

  .frame__device {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--max);
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 12%);
    border-radius: 0.75rem;
    background: #0f172a;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 28%) inset,
      0 18px 40px -20px rgb(15 23 42 / 40%);
    transform: rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz));
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  .frame--flat .frame__device {
    max-width: 100%;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(15 23 42 / 4%),
      0 16px 32px -22px rgb(15 23 42 / 26%);
    transform: none;
  }

  .frame__chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.5rem;
    padding: 0 0.65rem;
    background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    border-bottom: 1px solid rgb(255 255 255 / 6%);
  }

  .frame--tile .frame__chrome {
    height: 1.25rem;
    padding: 0 0.5rem;
  }

  .frame__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
  }

  .frame--tile .frame__dot {
    width: 0.34rem;
    height: 0.34rem;
  }

  .frame__dot--r {
    background: #f87171;
  }
  .frame__dot--y {
    background: #fbbf24;
  }
  .frame__dot--g {
    background: #34d399;
  }

  .frame__bar {
    margin-left: 0.55rem;
    height: 0.4rem;
    flex: 1;
    max-width: 40%;
    border-radius: 999px;
    background: rgb(255 255 255 / 10%);
  }

  .frame--tile .frame__bar {
    max-width: 34%;
    height: 0.32rem;
  }

  .frame__viewport {
    overflow: hidden;
    background: #f8fafc;
    aspect-ratio: 16 / 10;
  }

  .frame--tile .frame__viewport {
    aspect-ratio: 16 / 11;
  }

  .frame__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  @media (max-width: 640px) {
    .frame {
      --ry: -6deg;
      --rx: 4deg;
      --max: 100%;
    }

    .frame--hero,
    .frame--stage {
      --max: 22rem;
    }

    .frame__stage {
      padding-inline: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame,
    .frame--hero,
    .frame--stage,
    .frame--tile {
      --ry: 0deg;
      --rx: 0deg;
    }

    .frame__stage {
      perspective: none;
    }

    .frame__device {
      transform: none;
    }

    .frame__shadow {
      opacity: 0.55;
      transform: none;
    }
  }
</style>
